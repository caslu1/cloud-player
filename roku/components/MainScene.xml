<?xml version="1.0" encoding="utf-8"?>
<component name="MainScene" extends="Scene">
    <interface>
        <field id="exitApp" type="boolean" />
    </interface>
    <children>
        <Poster id="bg" width="1920" height="1080" uri="pkg:/images/bg.png" />
        <Group id="screens" />
        <Video id="video" width="1920" height="1080" visible="false" enableUI="true" />
        <LiveUI id="liveUI" />
        <VodUI id="vodUI" visible="false" />
        <Group id="errBox" visible="false">
            <Rectangle translation="[460,440]" width="1000" height="200" color="0x0C0A16F2" />
            <Label id="errMsg" translation="[500,470]" width="920" height="140" wrap="true" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" />
        </Group>
        <Timer id="errTimer" duration="7" />
    </children>
    <script type="text/brightscript" uri="pkg:/components/common.brs" />
    <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
</component>
